# Ce fichier est un exemple pour la configuration de production
# Copiez ce fichier vers .env.local et remplissez les valeurs appropriées

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=your-secret-key-here-change-this-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:password@127.0.0.1:3306/symfony_login?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
