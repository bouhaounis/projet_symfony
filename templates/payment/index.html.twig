{% extends 'base.html.twig' %}

{% block title %}💳 Paiements{% endblock %}

{% block body %}
    <div class="main-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h1 class="luxury-title">
                <i class="fas fa-credit-card"></i> Gestion des Paiements
            </h1>
            <a href="{{ path('app_payment_new') }}" class="btn-luxury">
                <i class="fas fa-plus"></i> Nouveau Paiement
            </a>
        </div>

        <!-- Liste des paiements -->
        <div class="luxury-card">
            {% if payments|length > 0 %}
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Montant</th>
                            <th>Méthode</th>
                            <th>Statut</th>
                            <th>Réservation</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for payment in payments %}
                            <tr>
                                <td><strong style="color: var(--gold);">#{{ payment.id }}</strong></td>
                                <td>
                                    <strong style="color: white; font-size: 1.1rem;">
                                        {{ payment.amount|number_format(2, ',', ' ') }} €
                                    </strong>
                                </td>
                                <td>
                                    {% if payment.methode == 'credit_card' %}
                                        <span class="badge-luxury">
                                            <i class="fas fa-credit-card"></i> Carte
                                        </span>
                                    {% elseif payment.methode == 'paypal' %}
                                        <span class="badge-luxury">
                                            <i class="fab fa-paypal"></i> PayPal
                                        </span>
                                    {% else %}
                                        <span class="badge-luxury">
                                            <i class="fas fa-money-bill"></i> {{ payment.methode|capitalize }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if payment.status == 'completed' %}
                                        <span class="badge-luxury badge-success">
                                            <i class="fas fa-check"></i> Complété
                                        </span>
                                    {% elseif payment.status == 'pending' %}
                                        <span class="badge-luxury badge-pending">
                                            <i class="fas fa-clock"></i> En attente
                                        </span>
                                    {% elseif payment.status == 'failed' %}
                                        <span class="badge-luxury badge-danger">
                                            <i class="fas fa-times"></i> Échoué
                                        </span>
                                    {% elseif payment.status == 'refunded' %}
                                        <span class="badge-luxury" style="background: rgba(139, 92, 246, 0.2); color: #8b5cf6;">
                                            <i class="fas fa-undo"></i> Remboursé
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if payment.booking %}
                                        <a href="{{ path('app_booking_show', {'id': payment.booking.id}) }}" class="link-gold">
                                            <i class="fas fa-receipt"></i> #{{ payment.booking.id }}
                                        </a>
                                    {% else %}
                                        <span style="color: rgba(255,255,255,0.5);">Aucune</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div style="color: rgba(255,255,255,0.7);">
                                        {{ payment.createdAt|date('d/m/Y H:i') }}
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px;">
                                        <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="btn-secondary" style="padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a href="{{ path('app_payment_edit', {'id': payment.id}) }}" class="btn-luxury" style="padding: 0.5rem 0.8rem;">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        {% if payment.status == 'pending' %}
                                            <form method="post" action="{{ path('payment_process', {'id': payment.id}) }}" style="display: inline;" onsubmit="return confirm('Traiter ce paiement ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('process' ~ payment.id) }}">
                                                <button type="submit" class="btn-secondary" style="padding: 0.5rem 0.8rem; background: rgba(34, 197, 94, 0.1); border-color: var(--success); color: var(--success);">
                                                    <i class="fas fa-play"></i>
                                                </button>
                                            </form>
                                        {% endif %}

                                        {% if payment.status == 'completed' %}
                                            <form method="post" action="{{ path('payment_refund', {'id': payment.id}) }}" style="display: inline;" onsubmit="return confirm('Rembourser ce paiement ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('refund' ~ payment.id) }}">
                                                <button type="submit" class="btn-secondary" style="padding: 0.5rem 0.8rem; background: rgba(139, 92, 246, 0.1); border-color: #8b5cf6; color: #8b5cf6;">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            </form>
                                        {% endif %}

                                        <form method="post" action="{{ path('app_payment_delete', {'id': payment.id}) }}" style="display: inline;" onsubmit="return confirm('Supprimer ce paiement ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment.id) }}">
                                            <button type="submit" class="btn-danger" style="padding: 0.5rem 0.8rem;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div style="text-align: center; padding: 3rem; color: rgba(255,255,255,0.6);">
                    <i class="fas fa-credit-card" style="font-size: 3rem; margin-bottom: 1rem; color: rgba(255,255,255,0.2);"></i>
                    <h3 style="color: var(--gold-light); margin-bottom: 0.5rem;">Aucun paiement</h3>
                    <p>Créez votre premier paiement !</p>
                    <a href="{{ path('app_payment_new') }}" class="btn-luxury" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> Créer un paiement
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .link-gold {
            color: var(--gold);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .link-gold:hover {
            color: #eab308;
            text-decoration: underline;
        }
    </style>
{% endblock %}
