{% extends 'base.html.twig' %}

{% block title %}✏️ Modifier Paiement #{{ payment.id }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Masquer les images d'événements */
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
            --purple: #8b5cf6;
        }

        .payment-form-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-container {
            max-width: 700px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .form-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .form-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 0 0 0.5rem 0;
        }

        .form-subtitle {
            color: #666;
            font-size: 1.1rem;
            margin: 0;
        }

        .form-subtitle strong {
            color: var(--primary);
            font-weight: 700;
        }

        .form-card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            margin-bottom: 2rem;
        }

        .status-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            border-left: 4px solid var(--primary);
        }

        .status-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .status-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .status-badge {
            padding: 0.75rem 1.25rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        .badge-completed {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .badge-pending {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
        }

        .badge-failed {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .badge-refunded {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
        }

        .status-date {
            color: #666;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .status-date i {
            color: var(--primary);
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .btn-back {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-back:hover {
            background: var(--primary);
            color: white;
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 1.5rem;
            }

            .form-title {
                font-size: 2rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="payment-form-page">
        <div class="form-container">
            <!-- En-tête -->
            <div class="form-header">
                <h1 class="form-title">
                    <i class="fas fa-edit"></i> Modifier Paiement
                </h1>
                <p class="form-subtitle">
                    Modification du paiement <strong>#{{ payment.id }}</strong>
                </p>
            </div>

            <!-- Carte du formulaire -->
            <div class="form-card">
                {{ include('payment/_form.html.twig') }}

                <div class="form-actions">
                    <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="btn-back">
                        <i class="fas fa-eye"></i> Voir détails
                    </a>
                    <a href="{{ path('app_payment_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Statut actuel -->
            <div class="status-card">
                <h3 class="status-title">
                    <i class="fas fa-chart-line"></i> Statut actuel
                </h3>
                <div class="status-info">
                    <div>
                        {% if payment.status == 'completed' %}
                            <span class="status-badge badge-completed">
                                <i class="fas fa-check-circle"></i> Complété
                            </span>
                        {% elseif payment.status == 'pending' %}
                            <span class="status-badge badge-pending">
                                <i class="fas fa-clock"></i> En attente
                            </span>
                        {% elseif payment.status == 'failed' %}
                            <span class="status-badge badge-failed">
                                <i class="fas fa-times-circle"></i> Échoué
                            </span>
                        {% elseif payment.status == 'refunded' %}
                            <span class="status-badge badge-refunded">
                                <i class="fas fa-undo"></i> Remboursé
                            </span>
                        {% endif %}
                    </div>
                    <div class="status-date">
                        <i class="far fa-calendar"></i>
                        Créé le {{ payment.createdAt|date('d/m/Y à H:i') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
