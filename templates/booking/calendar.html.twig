{% extends 'base.html.twig' %}

{% block title %}📅 Calendrier des événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Masquer le header et les événements en vedette */
        .main-header,
        .featured-events {
            display: none !important;
        }

        .calendar-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .calendar-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .calendar-header {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .calendar-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .calendar-nav {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-calendar-nav {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background: var(--gradient-primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-calendar-nav:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            color: white;
        }

        .btn-calendar-nav.secondary {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-calendar-nav.secondary:hover {
            background: var(--primary);
            color: white;
        }

        .current-month {
            font-size: 1.5rem;
            font-weight: 600;
            color: #333;
            min-width: 200px;
            text-align: center;
        }

        .calendar-grid {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
        }

        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .calendar-weekday {
            padding: 1rem;
            text-align: center;
            font-weight: 700;
            color: var(--primary);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(67, 97, 238, 0.05);
            border-radius: 8px;
        }

        .calendar-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .calendar-day {
            min-height: 140px;
            padding: 0.5rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            background: white;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .calendar-day.other-month {
            background: #f8f9fa;
            opacity: 0.6;
        }

        .calendar-day.today {
            border-color: var(--primary);
            background: rgba(67, 97, 238, 0.05);
            box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.2);
        }

        .calendar-day:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.15);
        }

        .day-number {
            font-weight: 700;
            font-size: 0.9rem;
            color: #333;
            margin-bottom: 0.5rem;
            z-index: 2;
            position: relative;
            background: rgba(255, 255, 255, 0.9);
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
            display: inline-block;
            width: fit-content;
        }

        .calendar-day.today .day-number {
            color: white;
            background: var(--primary);
            font-size: 1rem;
        }

        .day-events {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            position: relative;
        }

        .day-event {
            position: relative;
            width: 100%;
            height: 60px;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: block;
        }

        .day-event-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .day-event:hover .day-event-image {
            transform: scale(1.1);
        }

        .day-event-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
            padding: 0.5rem;
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        }

        .day-event-title {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .day-event.multiple {
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.75rem;
            text-align: center;
        }

        .day-event.multiple:hover {
            transform: scale(1.05);
            box-shadow: 0 2px 8px rgba(67, 97, 238, 0.4);
        }

        .event-count {
            font-size: 0.7rem;
            color: var(--primary);
            font-weight: 600;
            margin-top: 0.25rem;
        }

        .day-event-placeholder {
            width: 100%;
            height: 100%;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .calendar-legend {
            margin-top: 2rem;
            padding: 1.5rem;
            background: rgba(67, 97, 238, 0.05);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            color: #666;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: var(--gradient-primary);
        }

        .legend-color.today {
            background: rgba(67, 97, 238, 0.2);
            border: 2px solid var(--primary);
        }

        .legend-color.other-month {
            background: #f8f9fa;
            opacity: 0.6;
        }

        @media (max-width: 768px) {
            .calendar-day {
                min-height: 100px;
                padding: 0.4rem;
            }

            .day-event {
                height: 50px;
            }

            .day-event-overlay {
                padding: 0.3rem;
                font-size: 0.65rem;
            }

            .day-number {
                font-size: 0.8rem;
                padding: 0.15rem 0.3rem;
            }

            .calendar-header {
                flex-direction: column;
                text-align: center;
            }

            .calendar-nav {
                width: 100%;
                justify-content: center;
            }

            .current-month {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="calendar-page">
        <div class="calendar-container">
            <div class="calendar-header">
                <h1 class="calendar-title">
                    <i class="fas fa-calendar-alt"></i>
                    Calendrier des événements
                </h1>
                <div class="calendar-nav">
                    <a href="{{ path('app_booking_calendar', {year: prevYear, month: prevMonth}) }}" class="btn-calendar-nav">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <div class="current-month">{{ monthName }} {{ currentYear }}</div>
                    <a href="{{ path('app_booking_calendar', {year: nextYear, month: nextMonth}) }}" class="btn-calendar-nav">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    <a href="{{ path('app_booking_calendar') }}" class="btn-calendar-nav secondary">
                        <i class="fas fa-calendar-day"></i>
                        Aujourd'hui
                    </a>
                </div>
            </div>

            <div class="calendar-grid">
                <div class="calendar-weekdays">
                    <div class="calendar-weekday">Lun</div>
                    <div class="calendar-weekday">Mar</div>
                    <div class="calendar-weekday">Mer</div>
                    <div class="calendar-weekday">Jeu</div>
                    <div class="calendar-weekday">Ven</div>
                    <div class="calendar-weekday">Sam</div>
                    <div class="calendar-weekday">Dim</div>
                </div>

                <div class="calendar-days">
                    {% for day in calendarDays %}
                        <div class="calendar-day {% if not day.isCurrentMonth %}other-month{% endif %} {% if day.isToday %}today{% endif %}">
                            <div class="day-number">{{ day.date|date('j') }}</div>
                            <div class="day-events">
                                {% if day.events|length > 0 %}
                                    {% if day.events|length == 1 %}
                                        {% set event = day.events[0] %}
                                        {% set imageSrc = (event.image starts with 'http') ? event.image : app.request.basePath ~ '/uploads/events/' ~ event.image %}
                                        <a href="{{ path('app_booking_event_show', {id: event.id}) }}" class="day-event" title="{{ event.nom }}">
                                            {% if event.image %}
                                                <img src="{{ imageSrc }}" alt="{{ event.nom }}" class="day-event-image" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div class="day-event-placeholder" style="display: none;">
                                                    <i class="fas fa-calendar-alt"></i>
                                                </div>
                                            {% else %}
                                                <div class="day-event-placeholder">
                                                    <i class="fas fa-calendar-alt"></i>
                                                </div>
                                            {% endif %}
                                            <div class="day-event-overlay">
                                                <div class="day-event-title">{{ event.nom }}</div>
                                            </div>
                                        </a>
                                    {% else %}
                                        <div class="day-event multiple" title="{% for event in day.events %}{{ event.nom }}{% if not loop.last %}, {% endif %}{% endfor %}">
                                            <div>
                                                <i class="fas fa-calendar-check"></i>
                                                <div>{{ day.events|length }} événement(s)</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="calendar-legend">
                <div class="legend-item">
                    <div class="legend-color today"></div>
                    <span>Aujourd'hui</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color"></div>
                    <span>Événement</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color other-month"></div>
                    <span>Mois précédent/suivant</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

