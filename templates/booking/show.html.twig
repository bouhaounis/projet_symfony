{% extends 'base.html.twig' %}

{% block title %}📄 Réservation #{{ booking.id }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Masquer les images d'événements */
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
        }

        .booking-detail-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .booking-detail-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .page-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: #666;
            font-size: 1.1rem;
        }

        .booking-card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .booking-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .booking-event-hero {
            margin: -2.5rem -2.5rem 2rem;
            height: 260px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .booking-event-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.15));
        }

        .booking-event-hero-inner {
            position: relative;
            height: 100%;
            padding: 1.5rem 2.5rem;
            display: flex;
            align-items: flex-end;
            color: #f9fafb;
        }

        .booking-event-hero-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 0.25rem;
        }

        .booking-event-hero-meta {
            font-size: 0.95rem;
            opacity: 0.95;
        }

        .booking-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid rgba(67, 97, 238, 0.1);
        }

        .booking-id-section {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .booking-id-label {
            font-size: 0.75rem;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .booking-id-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary);
            font-family: 'Nunito', sans-serif;
        }

        .booking-status-badge {
            padding: 0.75rem 1.5rem;
            border-radius: 20px;
            font-size: 1rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .badge-confirmed {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .badge-pending {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
        }

        .badge-cancelled {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .info-section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .info-section-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .info-box {
            background: var(--gray-50);
            border-radius: 12px;
            padding: 1.5rem;
            border-left: 4px solid var(--primary);
        }

        .info-item {
            margin-bottom: 1rem;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-label {
            font-size: 0.85rem;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .info-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--gray-800);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .info-value.amount {
            font-size: 2rem;
            color: var(--primary);
        }

        .info-value.success {
            color: #22c55e;
        }

        .info-value.danger {
            color: #ef4444;
        }

        .financial-summary {
            background: var(--gradient-primary);
            color: white;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
        }

        .financial-item {
            text-align: center;
        }

        .financial-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .financial-value {
            font-size: 2rem;
            font-weight: 800;
        }

        .actions-section {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(67, 97, 238, 0.1);
        }

        .btn-action {
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(67, 97, 238, 0.4);
            color: white;
        }

        .btn-secondary {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-secondary:hover {
            background: var(--primary);
            color: white;
        }

        .btn-warning {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
            border: 2px solid #ff9e00;
        }

        .btn-warning:hover {
            background: #ff9e00;
            color: white;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 2px solid #ef4444;
        }

        .btn-danger:hover {
            background: #ef4444;
            color: white;
        }

        .payments-section {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
        }

        .payments-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid rgba(67, 97, 238, 0.1);
        }

        .payments-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .payments-table {
            width: 100%;
            border-collapse: collapse;
        }

        .payments-table thead tr {
            border-bottom: 2px solid rgba(67, 97, 238, 0.2);
        }

        .payments-table th {
            padding: 1rem;
            text-align: left;
            color: var(--primary);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .payments-table td {
            padding: 1rem;
            border-bottom: 1px solid rgba(67, 97, 238, 0.1);
            color: #333;
        }

        .payments-table tbody tr:hover {
            background: rgba(67, 97, 238, 0.02);
        }

        .payment-link {
            color: var(--primary);
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .payment-link:hover {
            color: var(--primary-light);
            text-decoration: underline;
        }

        .payment-status {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .status-completed {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .status-pending {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
        }

        .status-failed {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .status-refunded {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
        }

        .no-payments {
            text-align: center;
            padding: 3rem;
            color: var(--gray-600);
        }

        .no-payments-icon {
            font-size: 3rem;
            color: rgba(67, 97, 238, 0.2);
            margin-bottom: 1rem;
        }

        @media (max-width: 768px) {
            .booking-header {
                flex-direction: column;
                gap: 1rem;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .financial-summary {
                grid-template-columns: 1fr;
            }

            .actions-section {
                flex-direction: column;
            }

            .btn-action {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="booking-detail-page">
        <div class="booking-detail-container">
            <!-- En-tête -->
            <div class="page-header">
                <h1 class="page-title">
                    <i class="fas fa-file-invoice"></i> Détails de la Réservation
                </h1>
                <p class="page-subtitle">Informations complètes de la réservation #{{ booking.id }}</p>
            </div>

            <!-- Carte principale -->
            <div class="booking-card">
                {% if booking.event %}
                    {% set imageSrc = (booking.event.image starts with 'http') ? booking.event.image : app.request.basePath ~ '/uploads/events/' ~ booking.event.image %}
                    <div class="booking-event-hero" style="background-image: url('{{ imageSrc }}');">
                        <div class="booking-event-hero-inner">
                            <div>
                                <div class="booking-event-hero-title">{{ booking.event.nom }}</div>
                                <div class="booking-event-hero-meta">
                                    <i class="far fa-calendar-alt"></i>
                                    {{ booking.event.dateEvent ? booking.event.dateEvent|date('d/m/Y') : 'Date à venir' }}
                                    &nbsp;•&nbsp;
                                    <i class="fas fa-euro-sign"></i> {{ booking.event.prix }} €
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <!-- En-tête de la carte -->
                <div class="booking-header">
                    <div class="booking-id-section">
                        <div class="booking-id-label">Réservation</div>
                        <div class="booking-id-value">#{{ booking.id }}</div>
                        <div style="color: var(--gray-600); font-size: 0.9rem; margin-top: 0.5rem;">
                            <i class="far fa-calendar"></i> Créée le {{ booking.createdAt|date('d/m/Y à H:i') }}
                        </div>
                    </div>
                    <div>
                        {% if booking.status == 'confirmed' %}
                            <span class="booking-status-badge badge-confirmed">
                                <i class="fas fa-check-circle"></i> Confirmée
                            </span>
                        {% elseif booking.status == 'cancelled' %}
                            <span class="booking-status-badge badge-cancelled">
                                <i class="fas fa-times-circle"></i> Annulée
                            </span>
                        {% else %}
                            <span class="booking-status-badge badge-pending">
                                <i class="fas fa-clock"></i> {{ booking.status|capitalize }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                <!-- Indicateur de progression de paiement -->
                {% set totalPaid = booking.getTotalPaid() %}
                {% set totalAmount = booking.total %}
                {% set remainingBalance = booking.getRemainingBalance() %}
                {% set paymentProgress = totalAmount > 0 ? (totalPaid / totalAmount * 100) : 0 %}
                {% set paymentProgress = paymentProgress > 100 ? 100 : paymentProgress %}
                
                <div style="background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(72, 149, 239, 0.05) 100%); border-radius: 16px; padding: 2rem; margin-bottom: 2rem; border: 2px solid rgba(67, 97, 238, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <h3 style="font-size: 1.3rem; font-weight: 700; color: var(--primary); margin: 0; display: flex; align-items: center; gap: 0.75rem;">
                            <i class="fas fa-chart-line"></i>
                            Progression du paiement
                        </h3>
                        <span style="font-size: 1.1rem; font-weight: 700; color: var(--primary);">
                            {{ paymentProgress|number_format(1) }}%
                        </span>
                    </div>
                    
                    <div style="background: #e9ecef; border-radius: 12px; height: 24px; overflow: hidden; margin-bottom: 1rem; position: relative;">
                        <div style="background: {% if paymentProgress == 100 %}linear-gradient(90deg, #22c55e, #16a34a){% elseif paymentProgress > 0 %}linear-gradient(90deg, #4361ee, #4895ef){% else %}#e9ecef{% endif %}; height: 100%; width: {{ paymentProgress }}%; transition: width 0.6s ease; display: flex; align-items: center; justify-content: flex-end; padding-right: 0.5rem;">
                            {% if paymentProgress > 10 %}
                                <span style="color: white; font-size: 0.75rem; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                    {{ paymentProgress|number_format(0) }}%
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem;">
                        <div style="text-align: center; padding: 1rem; background: white; border-radius: 12px; border: 1px solid rgba(67, 97, 238, 0.1);">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; font-weight: 600;">Montant total</div>
                            <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary);">{{ totalAmount|number_format(2, ',', ' ') }} €</div>
                        </div>
                        <div style="text-align: center; padding: 1rem; background: white; border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.2);">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; font-weight: 600;">Payé</div>
                            <div style="font-size: 1.5rem; font-weight: 700; color: #22c55e;">{{ totalPaid|number_format(2, ',', ' ') }} €</div>
                        </div>
                        <div style="text-align: center; padding: 1rem; background: white; border-radius: 12px; border: 1px solid {% if remainingBalance > 0 %}rgba(239, 68, 68, 0.2){% else %}rgba(34, 197, 94, 0.2){% endif %};">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; font-weight: 600;">Reste à payer</div>
                            <div style="font-size: 1.5rem; font-weight: 700; color: {% if remainingBalance > 0 %}#ef4444{% else %}#22c55e{% endif %};">
                                {{ remainingBalance|number_format(2, ',', ' ') }} €
                            </div>
                        </div>
                    </div>
                    
                    {% if paymentProgress == 100 %}
                        <div style="margin-top: 1rem; padding: 1rem; background: rgba(34, 197, 94, 0.1); border-radius: 12px; border-left: 4px solid #22c55e; display: flex; align-items: center; gap: 1rem;">
                            <i class="fas fa-check-circle" style="font-size: 2rem; color: #22c55e;"></i>
                            <div>
                                <div style="font-weight: 700; color: #22c55e; margin-bottom: 0.25rem;">Paiement complet !</div>
                                <div style="color: #666; font-size: 0.9rem;">Votre réservation est entièrement payée.</div>
                            </div>
                        </div>
                    {% elseif remainingBalance > 0 %}
                        <div style="margin-top: 1rem; padding: 1rem; background: rgba(255, 158, 0, 0.1); border-radius: 12px; border-left: 4px solid #ff9e00; display: flex; align-items: center; gap: 1rem;">
                            <i class="fas fa-exclamation-circle" style="font-size: 2rem; color: #ff9e00;"></i>
                            <div style="flex: 1;">
                                <div style="font-weight: 700; color: #ff9e00; margin-bottom: 0.25rem;">Paiement en cours</div>
                                <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.75rem;">Il reste {{ remainingBalance|number_format(2, ',', ' ') }} € à régler pour finaliser votre réservation.</div>
                                {% if booking.canCreatePayment() %}
                                    <a href="{{ path('app_payment_new_for_booking', {bookingId: booking.id}) }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.5rem; background: var(--gradient-primary); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
                                        <i class="fas fa-credit-card"></i>
                                        Effectuer un paiement
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Informations -->
                <div class="info-grid">
                    <div class="info-section">
                        <div class="info-section-title">
                            <i class="fas fa-info-circle"></i> Informations
                        </div>
                        <div class="info-box">
                            <div class="info-item">
                                <div class="info-label">Événement</div>
                                <div class="info-value">
                                    <i class="fas fa-music" style="color: var(--primary);"></i>
                                    {{ booking.event ? booking.event.nom : 'Non renseigné' }}
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Date de l'événement</div>
                                <div class="info-value">
                                    <i class="far fa-calendar-check" style="color: var(--gray-600);"></i>
                                    {{ booking.event ? booking.event.dateEvent|date('d/m/Y') : 'N/A' }}
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Quantité de billets</div>
                                <div class="info-value">
                                    <i class="fas fa-ticket-alt" style="color: var(--primary);"></i>
                                    {{ booking.quantity }} billet(s)
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Prix unitaire</div>
                                <div class="info-value">
                                    {{ booking.event ? booking.event.prix|number_format(2, ',', ' ') : booking.total / (booking.quantity ?: 1)|number_format(2, ',', ' ') }} €
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="info-section">
                        <div class="info-section-title">
                            <i class="fas fa-euro-sign"></i> Financier
                        </div>
                        <div class="info-box">
                            <div class="info-item">
                                <div class="info-label">Total Réservation</div>
                                <div class="info-value amount">{{ booking.total|number_format(2, ',', ' ') }} €</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Déjà Payé</div>
                                <div class="info-value success">{{ booking.getTotalPaid()|number_format(2, ',', ' ') }} €</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Reste à Payer</div>
                                <div class="info-value danger">{{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €</div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Actions -->
                <div class="actions-section">
                    <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="btn-action btn-secondary">
                        <i class="fas fa-edit"></i> Modifier
                    </a>

                    {% if booking.canCreatePayment() %}
                        <a href="{{ path('app_payment_new_for_booking', {'bookingId': booking.id}) }}" class="btn-action btn-primary">
                            <i class="fas fa-credit-card"></i> Payer maintenant
                        </a>
                    {% else %}
                        <button class="btn-action btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed;">
                            <i class="fas fa-check-circle"></i> Paiement complet
                        </button>
                    {% endif %}

                    <a href="{{ path('app_payment_index') }}" class="btn-action btn-primary" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 2px solid #8b5cf6;">
                        <i class="fas fa-history"></i> Historique Paiements
                    </a>

                    {% if booking.status != 'cancelled' %}
                        <form method="post" action="{{ path('app_booking_cancel', {'id': booking.id}) }}" style="display: inline;" onsubmit="return confirm('Voulez-vous vraiment annuler cette réservation ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ booking.id) }}">
                            <button type="submit" class="btn-action btn-warning">
                                <i class="fas fa-ban"></i> Annuler
                            </button>
                        </form>
                    {% endif %}

                    <form method="post" action="{{ path('app_booking_delete', {'id': booking.id}) }}" style="display: inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette réservation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
                        <button type="submit" class="btn-action btn-danger">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                    </form>

                    <a href="{{ path('app_booking_index') }}" class="btn-action btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>

            <!-- Section Paiements -->
            <div class="payments-section">
                <div class="payments-header">
                    <h3 class="payments-title">
                        <i class="fas fa-history"></i> Historique des Paiements
                    </h3>
                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <a href="{{ path('app_payment_index') }}" class="btn-action btn-primary" style="padding: 0.75rem 1.25rem; font-size: 0.95rem;">
                            <i class="fas fa-history"></i> Voir tout l'historique
                        </a>
                        {% if booking.payments|length > 0 %}
                            <span style="background: rgba(67, 97, 238, 0.1); color: var(--primary); padding: 0.5rem 1rem; border-radius: 20px; font-weight: 600; font-size: 0.9rem;">
                                <i class="fas fa-receipt"></i> {{ booking.payments|length }} paiement(s)
                            </span>
                        {% endif %}
                    </div>
                </div>

                {% if booking.payments|length > 0 %}
                    <div style="overflow-x: auto;">
                        <table class="payments-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Montant</th>
                                    <th>Méthode</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for payment in booking.payments %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="payment-link">
                                                #{{ payment.id }}
                                            </a>
                                        </td>
                                        <td>
                                            <strong style="font-size: 1.1rem; color: var(--primary);">{{ payment.amount|number_format(2, ',', ' ') }} €</strong>
                                        </td>
                                        <td>
                                            {% if payment.methode == 'credit_card' %}
                                                <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                    <i class="fas fa-credit-card" style="color: var(--primary);"></i> Carte
                                                </span>
                                            {% elseif payment.methode == 'paypal' %}
                                                <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                    <i class="fab fa-paypal" style="color: var(--primary);"></i> PayPal
                                                </span>
                                            {% else %}
                                                <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                    <i class="fas fa-money-bill" style="color: var(--primary);"></i> {{ payment.methode|capitalize }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if payment.status == 'completed' %}
                                                <span class="payment-status status-completed">
                                                    <i class="fas fa-check-circle"></i> Complété
                                                </span>
                                            {% elseif payment.status == 'pending' %}
                                                <span class="payment-status status-pending">
                                                    <i class="fas fa-clock"></i> En attente
                                                </span>
                                            {% elseif payment.status == 'failed' %}
                                                <span class="payment-status status-failed">
                                                    <i class="fas fa-times-circle"></i> Échoué
                                                </span>
                                            {% elseif payment.status == 'refunded' %}
                                                <span class="payment-status status-refunded">
                                                    <i class="fas fa-undo"></i> Remboursé
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td style="color: var(--gray-600);">
                                            {{ payment.createdAt|date('d/m/Y à H:i') }}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="btn-action btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">
                                                <i class="fas fa-eye"></i> Voir
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="no-payments">
                        <div class="no-payments-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Aucun paiement</h3>
                        <p>Aucun paiement n'a été effectué pour cette réservation.</p>
                        {% if booking.canCreatePayment() %}
                            <a href="{{ path('app_payment_new_for_booking', {'bookingId': booking.id}) }}" class="btn-action btn-primary" style="margin-top: 1rem;">
                                <i class="fas fa-credit-card"></i> Effectuer un paiement
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
