{% extends 'base.html.twig' %}

{% block title %}🛒 Panier - Mes Réservations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Masquer les images d'événements */
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
        }

        .cart-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .cart-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .cart-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .cart-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 0.5rem;
        }

        .cart-subtitle {
            color: #666;
            font-size: 1.1rem;
        }

        .cart-item {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            transition: all 0.3s ease;
        }

        .cart-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(67, 97, 238, 0.2);
            border-color: var(--primary);
        }

        .cart-item-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid rgba(67, 97, 238, 0.1);
        }

        .cart-item-info h3 {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .cart-item-info p {
            color: #666;
            font-size: 0.95rem;
            margin: 0.25rem 0;
        }

        .cart-item-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .detail-box {
            background: rgba(67, 97, 238, 0.05);
            border-radius: 12px;
            padding: 1rem;
            border-left: 4px solid var(--primary);
        }

        .detail-label {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .detail-value {
            font-size: 1.3rem;
            color: var(--primary);
            font-weight: 700;
        }

        .badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .badge-success {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .badge-warning {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
        }

        .payment-details-section {
            background: rgba(67, 97, 238, 0.03);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(67, 97, 238, 0.1);
        }

        .payment-details-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .payments-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .payment-item {
            background: white;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 3px solid var(--primary);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .payment-item-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .payment-item-id {
            font-weight: 700;
            color: var(--primary);
            font-size: 0.9rem;
        }

        .payment-item-meta {
            font-size: 0.85rem;
            color: #666;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .payment-item-amount {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
        }

        .payment-status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .payment-status-completed {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .payment-status-pending {
            background: rgba(255, 158, 0, 0.1);
            color: #ff9e00;
        }

        .payment-status-failed {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .no-payments {
            text-align: center;
            padding: 1rem;
            color: #666;
            font-size: 0.9rem;
        }

        .cart-item-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-pay {
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            flex: 1;
            justify-content: center;
            min-width: 200px;
        }

        .btn-pay:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            color: white;
        }

        .btn-view {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
        }

        .btn-view:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        .empty-cart {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .empty-cart-icon {
            font-size: 5rem;
            color: rgba(67, 97, 238, 0.2);
            margin-bottom: 1.5rem;
        }

        .empty-cart h3 {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .empty-cart p {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .total-summary {
            background: var(--gradient-primary);
            color: white;
            border-radius: 20px;
            padding: 2rem;
            margin-top: 2rem;
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.3);
        }

        .total-summary h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .total-amount {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 1rem 0;
        }

        @media (max-width: 768px) {
            .cart-item-header {
                flex-direction: column;
                gap: 1rem;
            }

            .cart-item-details {
                grid-template-columns: 1fr;
            }

            .cart-item-actions {
                flex-direction: column;
            }

            .btn-pay, .btn-view {
                width: 100%;
            }

            .payment-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.75rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="cart-page">
        <div class="cart-container">
            <div class="cart-header">
                <h1 class="cart-title">
                    <i class="fas fa-shopping-cart"></i> Mon Panier
                </h1>
                <p class="cart-subtitle">Réservations en attente de paiement</p>
            </div>

            {% set bookingsItems = bookings.items is defined ? bookings.items : bookings %}
            {% if bookingsItems|length > 0 %}
                {% set totalPending = 0 %}
                {% set pendingCount = 0 %}
                {% for booking in bookingsItems %}
                    {% if booking.canCreatePayment() %}
                        {% set totalPending = totalPending + booking.getRemainingBalance() %}
                        {% set pendingCount = pendingCount + 1 %}
                    {% endif %}

                    <div class="cart-item">
                        <div class="cart-item-header">
                            <div class="cart-item-info">
                                <h3>Réservation #{{ booking.id }}</h3>
                                <p><i class="far fa-calendar"></i> Créée le {{ booking.createdAt|date('d/m/Y à H:i') }}</p>
                                <p><i class="fas fa-ticket-alt"></i> {{ booking.quantity }} billet(s)</p>
                            </div>
                            <div>
                                {% if booking.isFullyPaid() %}
                                    <span class="badge badge-success">
                                        <i class="fas fa-check-circle"></i> Déjà payée
                                    </span>
                                {% elseif booking.status == 'confirmed' %}
                                    <span class="badge badge-success">
                                        <i class="fas fa-check-circle"></i> Confirmée
                                    </span>
                                {% else %}
                                    <span class="badge badge-warning">
                                        <i class="fas fa-clock"></i> En attente
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Indicateur de progression de paiement -->
                        {% set totalPaid = booking.getTotalPaid() %}
                        {% set totalAmount = booking.total %}
                        {% set remainingBalance = booking.getRemainingBalance() %}
                        {% set paymentProgress = totalAmount > 0 ? (totalPaid / totalAmount * 100) : 0 %}
                        {% set paymentProgress = paymentProgress > 100 ? 100 : paymentProgress %}
                        
                        <div style="background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(72, 149, 239, 0.05) 100%); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; border: 2px solid rgba(67, 97, 238, 0.1);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <span style="font-size: 0.9rem; color: var(--primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fas fa-chart-line"></i>
                                    Progression du paiement
                                </span>
                                <span style="font-size: 1rem; font-weight: 700; color: var(--primary);">{{ paymentProgress|number_format(0) }}%</span>
                            </div>
                            <div style="background: #e9ecef; border-radius: 10px; height: 18px; overflow: hidden; margin-bottom: 1rem; position: relative;">
                                <div style="background: {% if paymentProgress == 100 %}linear-gradient(90deg, #22c55e, #16a34a){% elseif paymentProgress > 0 %}linear-gradient(90deg, #4361ee, #4895ef){% else %}#e9ecef{% endif %}; height: 100%; width: {{ paymentProgress }}%; transition: width 0.6s ease; border-radius: 10px; display: flex; align-items: center; justify-content: flex-end; padding-right: 0.5rem;">
                                    {% if paymentProgress > 15 %}
                                        <span style="color: white; font-size: 0.7rem; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                            {{ paymentProgress|number_format(0) }}%
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; font-size: 0.85rem;">
                                <div style="text-align: center;">
                                    <div style="color: #666; margin-bottom: 0.25rem; font-weight: 600;">Total</div>
                                    <div style="color: var(--primary); font-weight: 700; font-size: 1rem;">{{ totalAmount|number_format(2, ',', ' ') }} €</div>
                                </div>
                                <div style="text-align: center;">
                                    <div style="color: #666; margin-bottom: 0.25rem; font-weight: 600;">Payé</div>
                                    <div style="color: #22c55e; font-weight: 700; font-size: 1rem;">{{ totalPaid|number_format(2, ',', ' ') }} €</div>
                                </div>
                                <div style="text-align: center;">
                                    <div style="color: #666; margin-bottom: 0.25rem; font-weight: 600;">Reste</div>
                                    <div style="color: {% if remainingBalance > 0 %}#ef4444{% else %}#22c55e{% endif %}; font-weight: 700; font-size: 1rem;">{{ remainingBalance|number_format(2, ',', ' ') }} €</div>
                                </div>
                            </div>
                        </div>

                        <div class="cart-item-details">
                            <div class="detail-box">
                                <div class="detail-label">Total Réservation</div>
                                <div class="detail-value">{{ booking.total|number_format(2, ',', ' ') }} €</div>
                            </div>
                            <div class="detail-box">
                                <div class="detail-label">Déjà Payé</div>
                                <div class="detail-value" style="color: #22c55e;">{{ booking.getTotalPaid()|number_format(2, ',', ' ') }} €</div>
                            </div>
                            <div class="detail-box">
                                <div class="detail-label">Reste à Payer</div>
                                <div class="detail-value" style="color: #ef4444;">{{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €</div>
                            </div>
                        </div>

                        <!-- Détails des paiements -->
                        {% if booking.payments|length > 0 %}
                            <div class="payment-details-section">
                                <div class="payment-details-title">
                                    <i class="fas fa-credit-card"></i> Historique des Paiements
                                </div>
                                <div class="payments-list">
                                    {% for payment in booking.payments %}
                                        <div class="payment-item">
                                            <div class="payment-item-info">
                                                <div class="payment-item-id">
                                                    <i class="fas fa-receipt"></i> Paiement #{{ payment.id }}
                                                </div>
                                                <div class="payment-item-meta">
                                                    <span><i class="far fa-calendar"></i> {{ payment.createdAt|date('d/m/Y à H:i') }}</span>
                                                    <span>•</span>
                                                    <span>
                                                        {% if payment.methode == 'credit_card' %}
                                                            <i class="fas fa-credit-card"></i> Carte
                                                        {% elseif payment.methode == 'paypal' %}
                                                            <i class="fab fa-paypal"></i> PayPal
                                                        {% else %}
                                                            <i class="fas fa-money-bill"></i> {{ payment.methode|capitalize }}
                                                        {% endif %}
                                                    </span>
                                                </div>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 1rem;">
                                                <div class="payment-item-amount">{{ payment.amount|number_format(2, ',', ' ') }} €</div>
                                                <span class="payment-status-badge 
                                                    {% if payment.status == 'completed' %}payment-status-completed{% endif %}
                                                    {% if payment.status == 'pending' %}payment-status-pending{% endif %}
                                                    {% if payment.status == 'failed' %}payment-status-failed{% endif %}">
                                                    {% if payment.status == 'completed' %}
                                                        <i class="fas fa-check-circle"></i> Complété
                                                    {% elseif payment.status == 'pending' %}
                                                        <i class="fas fa-clock"></i> En attente
                                                    {% elseif payment.status == 'failed' %}
                                                        <i class="fas fa-times-circle"></i> Échoué
                                                    {% else %}
                                                        {{ payment.status|capitalize }}
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="payment-details-section">
                                <div class="no-payments">
                                    <i class="fas fa-info-circle"></i> Aucun paiement effectué pour cette réservation
                                </div>
                            </div>
                        {% endif %}

                        <div class="cart-item-actions">
                            {% if booking.canCreatePayment() %}
                                <a href="{{ path('app_payment_new_for_booking', {'bookingId': booking.id}) }}" class="btn-pay">
                                    <i class="fas fa-credit-card"></i> Payer {{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €
                                </a>
                            {% else %}
                                <button class="btn-pay" disabled style="opacity: 0.6; cursor: not-allowed; background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 2px solid #22c55e;">
                                    <i class="fas fa-check-circle"></i> Déjà payée
                                </button>
                            {% endif %}
                            <a href="{{ path('app_booking_show', {'id': booking.id}) }}" class="btn-view">
                                <i class="fas fa-eye"></i> Voir les détails
                            </a>
                        </div>
                    </div>
                {% endfor %}

                {# Pagination #}
                {% if bookings is iterable and bookings.currentPageNumber is defined %}
                <div class="pagination-wrapper" style="margin-top: 3rem; display: flex; justify-content: center;">
                    {{ knp_pagination_render(bookings) }}
                </div>
                {% endif %}

                {% if pendingCount > 0 %}
                    <div class="total-summary">
                        <h3><i class="fas fa-calculator"></i> Récapitulatif</h3>
                        <p style="opacity: 0.9; margin-bottom: 0.5rem;">Total à payer pour les réservations en attente</p>
                        <div class="total-amount">{{ totalPending|number_format(2, ',', ' ') }} €</div>
                        <p style="opacity: 0.8; font-size: 0.9rem;">{{ pendingCount }} réservation(s) en attente de paiement</p>
                    </div>
                {% endif %}
            {% else %}
                <div class="empty-cart">
                    <div class="empty-cart-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h3>Votre panier est vide</h3>
                    <p>Toutes vos réservations sont payées ou vous n'avez pas encore de réservation en attente.</p>
                    <a href="{{ path('app_booking_new') }}" class="btn-pay" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> Créer une réservation
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
