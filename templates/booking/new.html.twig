{% extends 'base.html.twig' %}

{% block title %}✨ Nouvelle Réservation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Masquer les images d'événements */
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
        }

        .booking-form-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 2rem;
        }

        .form-main {
            grid-column: 1;
        }

        .form-sidebar {
            grid-column: 2;
        }

        @media (max-width: 968px) {
            .form-container {
                grid-template-columns: 1fr;
            }
            .form-sidebar {
                grid-column: 1;
            }
        }

        .form-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .form-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 0 0 0.5rem 0;
        }

        .form-subtitle {
            color: #666;
            font-size: 1.1rem;
            margin: 0;
        }

        .form-card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .info-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            border-left: 4px solid var(--primary);
            position: sticky;
            top: 2rem;
        }

        .info-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .info-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            color: #666;
            font-size: 1rem;
            border-bottom: 1px solid rgba(67, 97, 238, 0.1);
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item i {
            color: var(--primary);
            font-size: 1.1rem;
        }

        .info-item strong {
            color: var(--primary);
            font-weight: 700;
        }

        .quick-stats {
            background: var(--gradient-primary);
            color: white;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .quick-stats-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            opacity: 0.9;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .stat-row:last-child {
            border-bottom: none;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .stat-value {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .form-group {
            margin-bottom: 2rem;
        }

        .form-label {
            display: block;
            font-weight: 700;
            color: #333;
            margin-bottom: 0.75rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label i {
            color: var(--primary);
        }

        .form-control {
            width: 100%;
            padding: 1rem 1.25rem;
            font-size: 1.1rem;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            transition: all 0.3s ease;
            background: #f8f9fa;
            color: #333;
            font-weight: 600;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
        }

        .form-text {
            margin-top: 0.5rem;
            font-size: 0.9rem;
            color: #666;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-text i {
            color: var(--primary);
        }

        .error-message {
            color: var(--danger);
            margin-top: 0.5rem;
            font-size: 0.9rem;
            background: rgba(239, 68, 68, 0.1);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border-left: 4px solid var(--danger);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .error-message i {
            color: var(--danger);
        }

        .btn-submit {
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
        }

        .btn-submit:active {
            transform: translateY(-1px);
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .btn-back {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-back:hover {
            background: var(--primary);
            color: white;
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 1.5rem;
            }

            .form-title {
                font-size: 2rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="booking-form-page">
        <div class="form-container">
            <div class="form-main">
                <!-- En-tête -->
                <div class="form-header">
                    <h1 class="form-title">
                        <i class="fas fa-plus-circle"></i> Nouvelle Réservation
                    </h1>
                    <p class="form-subtitle">
                        Créez une nouvelle réservation avec notre service
                    </p>
                </div>

                <!-- Carte du formulaire -->
                <div class="form-card">
                    {{ include('booking/_form.html.twig') }}

                    <div class="form-actions">
                        <a href="{{ path('app_booking_index') }}" class="btn-back">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>

            <div class="form-sidebar">
                <!-- Statistiques rapides -->
                <div class="quick-stats">
                    <div class="quick-stats-title">
                        <i class="fas fa-chart-line"></i> Informations Rapides
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Prix unitaire</span>
                        <span class="stat-value">10.00 €</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Calcul</span>
                        <span class="stat-value">Automatique</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Statut initial</span>
                        <span class="stat-value">En attente</span>
                    </div>
                </div>

                <!-- Informations -->
                <div class="info-card">
                    <h3 class="info-title">
                        <i class="fas fa-info-circle"></i> Informations importantes
                    </h3>
                    <ul class="info-list">
                        <li class="info-item">
                            <i class="fas fa-check-circle"></i>
                            <strong>Prix unitaire:</strong> 10€ par billet
                        </li>
                        <li class="info-item">
                            <i class="fas fa-calculator"></i>
                            <strong>Calcul automatique:</strong> Le total est calculé automatiquement
                        </li>
                        <li class="info-item">
                            <i class="fas fa-clock"></i>
                            <strong>Statut initial:</strong> <span style="background: rgba(255, 158, 0, 0.1); color: #ff9e00; padding: 0.25rem 0.75rem; border-radius: 20px; font-weight: 600; font-size: 0.9rem;">En attente</span>
                        </li>
                        <li class="info-item">
                            <i class="fas fa-credit-card"></i>
                            <strong>Paiement:</strong> Vous pourrez payer après la création
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
