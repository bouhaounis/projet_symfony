{% extends 'emails/base_email.html.twig' %}

{% block content %}
<div class="email-content">
    <h2 style="color: #ff9e00; margin-top: 0;">💳 Rappel de paiement</h2>
    
    <p>Bonjour <strong>{{ user.email }}</strong>,</p>
    
    <p>Nous vous rappelons qu'il reste un solde à régler pour votre réservation.</p>
    
    <div class="info-box" style="border-left-color: #ff9e00;">
        <div class="detail-row">
            <span class="detail-label">Numéro de réservation :</span>
            <span class="detail-value"><strong>#{{ booking.id }}</strong></span>
        </div>
        {% if event %}
        <div class="detail-row">
            <span class="detail-label">Événement :</span>
            <span class="detail-value"><strong>{{ event.nom }}</strong></span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Date de l'événement :</span>
            <span class="detail-value">{{ event.dateEvent|date('d/m/Y') }}</span>
        </div>
        {% endif %}
        <div class="detail-row">
            <span class="detail-label">Montant total :</span>
            <span class="detail-value">{{ booking.total|number_format(2, ',', ' ') }} €</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Montant payé :</span>
            <span class="detail-value" style="color: #22c55e;">{{ booking.getTotalPaid()|number_format(2, ',', ' ') }} €</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Solde restant :</span>
            <span class="detail-value" style="font-size: 18px; color: #ef4444;">
                <strong>{{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €</strong>
            </span>
        </div>
    </div>

    <p style="margin-top: 25px;">
        <strong>Pour finaliser votre réservation, veuillez effectuer le paiement du solde restant.</strong>
    </p>

    <p style="text-align: center;">
        <a href="{{ absolute_url(path('app_booking_cart')) }}" class="button">Effectuer le paiement</a>
    </p>

    <p style="margin-top: 30px; color: #666; font-size: 14px;">
        Si vous avez déjà effectué ce paiement, merci de ne pas tenir compte de cet email.
    </p>
</div>
{% endblock %}


