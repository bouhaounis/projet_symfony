{% extends 'emails/base_email.html.twig' %}

{% block content %}
<div class="email-content">
    <h2 style="color: #22c55e; margin-top: 0;">💳 Confirmation de paiement</h2>
    
    <p>Bonjour <strong>{{ user.email }}</strong>,</p>
    
    <p>Votre paiement a été enregistré avec succès !</p>
    
    <div class="info-box">
        <div class="detail-row">
            <span class="detail-label">Numéro de paiement :</span>
            <span class="detail-value"><strong>#{{ payment.id }}</strong></span>
        </div>
        {% if booking %}
        <div class="detail-row">
            <span class="detail-label">Réservation associée :</span>
            <span class="detail-value"><strong>#{{ booking.id }}</strong></span>
        </div>
        {% endif %}
        <div class="detail-row">
            <span class="detail-label">Montant payé :</span>
            <span class="detail-value" style="font-size: 18px; color: #22c55e;"><strong>{{ payment.amount|number_format(2, ',', ' ') }} €</strong></span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Méthode de paiement :</span>
            <span class="detail-value">{{ payment.method|capitalize }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Statut :</span>
            <span class="detail-value">
                {% if payment.status == 'completed' %}
                    <span class="badge badge-success">Complété</span>
                {% elseif payment.status == 'pending' %}
                    <span class="badge badge-warning">En attente</span>
                {% elseif payment.status == 'failed' %}
                    <span class="badge badge-danger">Échoué</span>
                {% else %}
                    <span class="badge">{{ payment.status|capitalize }}</span>
                {% endif %}
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Date du paiement :</span>
            <span class="detail-value">{{ payment.createdAt|date('d/m/Y à H:i') }}</span>
        </div>
    </div>

    {% if booking %}
    <div class="info-box" style="background-color: #f0f9ff; border-left-color: #22c55e; margin-top: 20px;">
        <p style="margin: 0 0 10px 0; font-weight: 600;">État de la réservation :</p>
        <div class="detail-row">
            <span class="detail-label">Total de la réservation :</span>
            <span class="detail-value">{{ booking.total|number_format(2, ',', ' ') }} €</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Total payé :</span>
            <span class="detail-value" style="color: #22c55e;">{{ booking.getTotalPaid()|number_format(2, ',', ' ') }} €</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Solde restant :</span>
            <span class="detail-value" style="color: {% if booking.getRemainingBalance() > 0 %}#ef4444{% else %}#22c55e{% endif %};">
                <strong>{{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €</strong>
            </span>
        </div>
    </div>

    {% if booking.getRemainingBalance() > 0 %}
    <p style="margin-top: 25px;">
        Il vous reste <strong>{{ booking.getRemainingBalance()|number_format(2, ',', ' ') }} €</strong> à régler pour finaliser votre réservation.
    </p>
    <p style="text-align: center;">
        <a href="{{ absolute_url(path('app_booking_cart')) }}" class="button">Effectuer un nouveau paiement</a>
    </p>
    {% else %}
    <p style="margin-top: 25px; color: #22c55e; font-weight: 600; text-align: center;">
        ✅ Votre réservation est maintenant entièrement payée !
    </p>
    {% endif %}
    {% endif %}

    <p style="margin-top: 30px;">
        Vous pouvez consulter le détail de votre paiement et de votre réservation en cliquant sur le lien ci-dessous.
    </p>
    
    {% if booking %}
    <p style="text-align: center;">
        <a href="{{ absolute_url(path('app_booking_show', {id: booking.id})) }}" class="button">Voir ma réservation</a>
    </p>
    {% endif %}

    <p style="margin-top: 30px; color: #666; font-size: 14px;">
        Cet email fait office de reçu de paiement. Conservez-le pour vos archives.
    </p>
</div>
{% endblock %}

