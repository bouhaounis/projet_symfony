{% extends 'base.html.twig' %}

{% block title %}🎉 Gestion des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --success: #22c55e;
            --danger: #ef4444;
            --gray-50: #f9fafb;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
        }

        .events-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .events-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 0;
        }

        .page-subtitle {
            color: var(--gray-600);
            margin-top: 0.5rem;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .event-card {
            background: white;
            border-radius: 16px;
            padding: 0;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .event-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(67, 97, 238, 0.15);
            border-color: var(--primary);
        }

        .event-card:hover::before {
            transform: scaleX(1);
        }

        .event-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 16px 16px 0 0;
            background: linear-gradient(135deg, #4361ee 0%, #4895ef 100%);
            display: block;
        }
        
        .event-image[src=""] {
            display: none;
        }

        .event-image-placeholder {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, #4361ee 0%, #4895ef 100%);
            border-radius: 16px 16px 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .event-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .event-header {
            margin-bottom: 1rem;
        }

        .event-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-family: 'Nunito', sans-serif;
        }

        .event-description {
            color: var(--gray-600);
            font-size: 0.9rem;
            margin-bottom: 1rem;
            line-height: 1.5;
        }

        .event-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding: 1rem;
            background: var(--gray-50);
            border-radius: 12px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .detail-label {
            font-size: 0.7rem;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .detail-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--gray-800);
        }

        .detail-value.price {
            color: var(--primary);
            font-size: 1.1rem;
            font-weight: 700;
        }

        .event-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid var(--gray-200);
        }

        .btn-action {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            border: none;
            cursor: pointer;
            font-weight: 600;
            text-align: center;
        }

        .btn-primary-action {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 2px 8px rgba(67, 97, 238, 0.2);
        }

        .btn-primary-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            color: white;
        }

        .btn-secondary-action {
            background: white;
            color: var(--primary);
            border: 1.5px solid var(--primary);
        }

        .btn-secondary-action:hover {
            background: var(--primary);
            color: white;
        }

        .btn-danger-action {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1.5px solid #ef4444;
        }

        .btn-danger-action:hover {
            background: #ef4444;
            color: white;
        }

        .btn-create {
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .btn-create:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            color: white;
        }

        .empty-state {
            background: white;
            border-radius: 16px;
            padding: 4rem 2rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
        }

        .empty-icon {
            font-size: 5rem;
            color: rgba(67, 97, 238, 0.2);
            margin-bottom: 1.5rem;
        }

        .empty-title {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        @media (max-width: 768px) {
            .events-grid {
                grid-template-columns: 1fr;
            }

            .event-details {
                grid-template-columns: 1fr;
            }

            .event-actions {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="events-page">
        <div class="events-container">
            <div class="page-header">
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-calendar-alt"></i> Gestion des Événements
                    </h1>
                    <p class="page-subtitle">Gérez tous les événements disponibles</p>
                </div>
                <a href="{{ path('app_event_new') }}" class="btn-create">
                    <i class="fas fa-plus"></i> Nouvel Événement
                </a>
            </div>

            {% set eventsItems = events.items is defined ? events.items : events %}
            {% if eventsItems|length > 0 %}
                <div class="events-grid">
                    {% for event in eventsItems %}
                        <div class="event-card">
                            {% if event.image and event.image|trim != '' %}
                                {% set imageSrc = (event.image starts with 'http') ? event.image : app.request.basePath ~ '/uploads/events/' ~ event.image %}
                                <img src="{{ imageSrc }}" alt="{{ event.nom|e }}" class="event-image" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="event-image-placeholder" style="display: none;">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                            {% else %}
                                <div class="event-image-placeholder">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                            {% endif %}
                            <div class="event-content">
                                <div class="event-header">
                                    <h3 class="event-title">{{ event.nom }}</h3>
                                    {% if event.description %}
                                        <p class="event-description">{{ event.description }}</p>
                                    {% endif %}
                                </div>

                                <div class="event-details">
                                    <div class="detail-item">
                                        <div class="detail-label">Date</div>
                                        <div class="detail-value">
                                            <i class="far fa-calendar"></i>
                                            {{ event.dateEvent|date('d/m/Y') }}
                                        </div>
                                    </div>
                                    <div class="detail-item">
                                        <div class="detail-label">Capacité</div>
                                        <div class="detail-value">
                                            <i class="fas fa-users"></i>
                                            {{ event.capacity }} places
                                        </div>
                                    </div>
                                    <div class="detail-item" style="grid-column: 1 / -1;">
                                        <div class="detail-label">Prix</div>
                                        <div class="detail-value price">
                                            <i class="fas fa-euro-sign"></i>
                                            {{ event.prix|number_format(2, ',', ' ') }} €
                                        </div>
                                    </div>
                                </div>

                                <div class="event-actions">
                                    <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn-action btn-primary-action">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn-action btn-secondary-action">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_event_delete', {'id': event.id}) }}" style="display: contents;" onsubmit="return confirm('Voulez-vous vraiment supprimer cet événement ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                        <button type="submit" class="btn-action btn-danger-action" style="grid-column: 1 / -1;">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                
                {# Pagination #}
                {% if events is iterable and events.currentPageNumber is defined %}
                <div class="pagination-wrapper" style="margin-top: 3rem; display: flex; justify-content: center;">
                    {{ knp_pagination_render(events) }}
                </div>
                {% endif %}
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-calendar-times"></i>
                    </div>
                    <h3 class="empty-title">Aucun événement</h3>
                    <p style="color: var(--gray-600); margin-bottom: 2rem;">Commencez par créer votre premier événement !</p>
                    <a href="{{ path('app_event_new') }}" class="btn-create">
                        <i class="fas fa-plus"></i> Créer un événement
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
