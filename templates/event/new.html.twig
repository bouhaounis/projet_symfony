{% extends 'base.html.twig' %}

{% block title %}➕ Nouvel Événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --gray-50: #f9fafb;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
        }

        .event-form-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .form-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 2rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 1rem 1.25rem;
            font-size: 1rem;
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            transition: all 0.3s ease;
            background: var(--gray-50);
            color: var(--gray-800);
            font-family: 'Poppins', sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        .btn-submit {
            width: 100%;
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1.1rem 2rem;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            margin-top: 1rem;
            font-family: 'Poppins', sans-serif;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
        }

        .btn-back {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            margin-top: 1rem;
            width: 100%;
            justify-content: center;
        }

        .btn-back:hover {
            background: var(--primary);
            color: white;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 2rem;
            }

            .form-title {
                font-size: 2rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script>
        function previewImage(url) {
            const previewDiv = document.getElementById('image-preview');
            const previewImg = document.getElementById('preview-img');
            
            if (url && url.trim() !== '') {
                previewImg.src = url;
                previewDiv.style.display = 'block';
                previewImg.onerror = function() {
                    previewDiv.innerHTML = '<div style="padding: 1rem; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 8px; border-left: 3px solid #ef4444;"><i class="fas fa-exclamation-triangle"></i> Impossible de charger l\'image. Vérifiez que l\'URL est correcte.</div>';
                };
                previewImg.onload = function() {
                    previewDiv.innerHTML = '<label class="form-label">Aperçu:</label><img id="preview-img" src="' + url + '" alt="Aperçu" style="max-width: 100%; max-height: 200px; border-radius: 12px; border: 2px solid var(--gray-200);">';
                };
            } else {
                previewDiv.style.display = 'none';
            }
        }
        
        // Initialiser l'aperçu si une valeur existe déjà
        document.addEventListener('DOMContentLoaded', function() {
            const imageInput = document.getElementById('event_image_url');
            if (imageInput && imageInput.value) {
                previewImage(imageInput.value);
            }
        });
    </script>
{% endblock %}

{% block body %}
    <div class="event-form-page">
        <div class="form-container">
            <div class="form-card">
                <h1 class="form-title">
                    <i class="fas fa-calendar-plus"></i> Nouvel Événement
                </h1>

                {{ form_start(form) }}
                    {{ form_row(form.nom, {
                        'label': 'Nom de l\'événement',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <div class="form-group">
                        {{ form_label(form.image, 'URL de l\'image', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.image, {'attr': {'class': 'form-control', 'id': 'event_image_url', 'oninput': 'previewImage(this.value)'}}) }}
                        {{ form_errors(form.image) }}
                        <small style="color: var(--gray-600); margin-top: 0.5rem; display: block;">
                            <i class="fas fa-info-circle"></i> Entrez une URL complète (ex: https://example.com/image.jpg)
                        </small>
                        <div id="image-preview" style="margin-top: 1rem; display: none;">
                            <label class="form-label">Aperçu:</label>
                            <img id="preview-img" src="" alt="Aperçu" style="max-width: 100%; max-height: 200px; border-radius: 12px; border: 2px solid var(--gray-200);">
                        </div>
                    </div>

                    {{ form_row(form.description, {
                        'label': 'Description',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <div class="form-row">
                        {{ form_row(form.dateEvent, {
                            'label': 'Date de l\'événement',
                            'attr': {'class': 'form-control'}
                        }) }}

                        {{ form_row(form.capacity, {
                            'label': 'Capacité',
                            'attr': {'class': 'form-control'}
                        }) }}
                    </div>

                    {{ form_row(form.prix, {
                        'label': 'Prix',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-check"></i> Créer l'événement
                    </button>
                {{ form_end(form) }}

                <a href="{{ path('app_event_index') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}
