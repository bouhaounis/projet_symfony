{% extends 'base.html.twig' %}

{% block title %}➕ Nouvel Événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --gray-50: #f9fafb;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
        }

        .event-form-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .form-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 2rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 1rem 1.25rem;
            font-size: 1rem;
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            transition: all 0.3s ease;
            background: var(--gray-50);
            color: var(--gray-800);
            font-family: 'Poppins', sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        .image-choice-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            border-bottom: 2px solid var(--gray-200);
        }

        .image-choice-tab {
            padding: 0.75rem 1.5rem;
            background: transparent;
            border: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            font-weight: 600;
            color: var(--gray-600);
            transition: all 0.3s ease;
            font-family: 'Poppins', sans-serif;
        }

        .image-choice-tab.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        .image-choice-tab:hover {
            color: var(--primary);
        }

        .image-option {
            display: none;
        }

        .image-option.active {
            display: block;
        }

        .file-input-wrapper {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .file-input {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            z-index: 10;
        }

        .file-input-label {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.25rem;
            background: var(--gray-50);
            border: 2px dashed var(--gray-200);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Poppins', sans-serif;
        }

        .file-input-label:hover {
            background: rgba(67, 97, 238, 0.05);
            border-color: var(--primary);
        }

        .file-input-label .file-name {
            color: var(--gray-600);
            font-size: 0.95rem;
        }

        .file-input-label .file-button {
            background: var(--gradient-primary);
            color: white;
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .file-input-label:hover .file-button {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .btn-submit {
            width: 100%;
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1.1rem 2rem;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            margin-top: 1rem;
            font-family: 'Poppins', sans-serif;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
        }

        .btn-back {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            margin-top: 1rem;
            width: 100%;
            justify-content: center;
        }

        .btn-back:hover {
            background: var(--primary);
            color: white;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 2rem;
            }

            .form-title {
                font-size: 2rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script>
        function switchImageOption(option) {
            document.querySelectorAll('.image-choice-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.image-option').forEach(opt => {
                opt.classList.remove('active');
            });
            
            document.querySelector(`[data-option="${option}"]`).classList.add('active');
            document.getElementById(`image-option-${option}`).classList.add('active');
            
            // Réinitialiser les champs
            if (option === 'upload') {
                document.getElementById('event_image_url').value = '';
            } else {
                document.getElementById('event_image_file').value = '';
            }
            document.getElementById('image-preview').style.display = 'none';
        }

        function previewImageFile(input) {
            const previewDiv = document.getElementById('image-preview');
            const previewImg = document.getElementById('preview-img');
            const fileName = document.querySelector('.file-name');
            
            if (input.files && input.files[0]) {
                fileName.textContent = input.files[0].name;
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    previewDiv.style.display = 'block';
                };
                
                reader.readAsDataURL(input.files[0]);
            } else {
                fileName.textContent = 'Aucun fichier sélectionné';
                previewDiv.style.display = 'none';
            }
        }

        function previewImageUrl(input) {
            const previewDiv = document.getElementById('image-preview');
            const previewImg = document.getElementById('preview-img');
            
            if (input.value && input.value.trim() !== '') {
                previewImg.src = input.value;
                previewDiv.style.display = 'block';
                previewImg.onerror = function() {
                    previewDiv.innerHTML = '<div style="padding: 1rem; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 8px; border-left: 3px solid #ef4444;"><i class="fas fa-exclamation-triangle"></i> Impossible de charger l\'image. Vérifiez que l\'URL est correcte.</div>';
                };
                previewImg.onload = function() {
                    previewDiv.innerHTML = '<label class="form-label">Aperçu:</label><img id="preview-img" src="' + input.value + '" alt="Aperçu" style="max-width: 100%; max-height: 200px; border-radius: 12px; border: 2px solid var(--gray-200);">';
                };
            } else {
                previewDiv.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initialiser avec l'option upload par défaut
            switchImageOption('upload');
        });
    </script>
{% endblock %}

{% block body %}
    <div class="event-form-page">
        <div class="form-container">
            <div class="form-card">
                <h1 class="form-title">
                    <i class="fas fa-calendar-plus"></i> Nouvel Événement
                </h1>

                {{ form_start(form) }}
                    {{ form_row(form.nom, {
                        'label': 'Nom de l\'événement',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <div class="form-group">
                        <label class="form-label">Image de l'événement *</label>
                        
                        <!-- Onglets de choix -->
                        <div class="image-choice-tabs">
                            <button type="button" class="image-choice-tab active" data-option="upload" onclick="switchImageOption('upload')">
                                <i class="fas fa-upload"></i> Uploader un fichier
                            </button>
                            <button type="button" class="image-choice-tab" data-option="url" onclick="switchImageOption('url')">
                                <i class="fas fa-link"></i> Utiliser une URL
                            </button>
                        </div>

                        <!-- Option Upload -->
                        <div id="image-option-upload" class="image-option active">
                            <div class="file-input-wrapper">
                                {{ form_widget(form.imageFile, {'attr': {'class': 'file-input', 'id': 'event_image_file', 'accept': 'image/*', 'onchange': 'previewImageFile(this)'}}) }}
                                <label for="event_image_file" class="file-input-label" onclick="document.getElementById('event_image_file').click(); return false;">
                                    <span class="file-name">Aucun fichier sélectionné</span>
                                    <span class="file-button">
                                        <i class="fas fa-folder-open"></i> Choisir un fichier
                                    </span>
                                </label>
                            </div>
                            {{ form_errors(form.imageFile) }}
                            <small style="color: var(--gray-600); margin-top: 0.5rem; display: block;">
                                <i class="fas fa-info-circle"></i> Formats acceptés: JPEG, PNG, GIF, WebP (max 5MB)
                            </small>
                        </div>

                        <!-- Option URL -->
                        <div id="image-option-url" class="image-option">
                            {{ form_label(form.imageUrl, false, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.imageUrl, {'attr': {'class': 'form-control', 'id': 'event_image_url', 'placeholder': 'https://example.com/image.jpg', 'oninput': 'previewImageUrl(this)'}}) }}
                            {{ form_errors(form.imageUrl) }}
                            <small style="color: var(--gray-600); margin-top: 0.5rem; display: block;">
                                <i class="fas fa-info-circle"></i> Entrez une URL complète (ex: https://example.com/image.jpg)
                            </small>
                        </div>

                        <!-- Aperçu -->
                        <div id="image-preview" style="margin-top: 1rem; display: none;">
                            <label class="form-label">Aperçu:</label>
                            <img id="preview-img" src="" alt="Aperçu" style="max-width: 100%; max-height: 200px; border-radius: 12px; border: 2px solid var(--gray-200);">
                        </div>
                    </div>

                    {{ form_row(form.description, {
                        'label': 'Description',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <div class="form-row">
                        {{ form_row(form.dateEvent, {
                            'label': 'Date de l\'événement',
                            'attr': {'class': 'form-control'}
                        }) }}

                        {{ form_row(form.capacity, {
                            'label': 'Capacité',
                            'attr': {'class': 'form-control'}
                        }) }}
                    </div>

                    {{ form_row(form.prix, {
                        'label': 'Prix',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-check"></i> Créer l'événement
                    </button>
                {{ form_end(form) }}

                <a href="{{ path('app_event_index') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}
