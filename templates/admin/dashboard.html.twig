{% extends 'base.html.twig' %}

{% block title %}📊 Dashboard Administrateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
            --purple: #8b5cf6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
        }

        .dashboard-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .page-header {
            margin-bottom: 2.5rem;
        }

        .page-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: var(--gray-600);
            font-size: 1.1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(67, 97, 238, 0.15);
        }

        .stat-card:hover::before {
            transform: scaleX(1);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            background: rgba(67, 97, 238, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--primary);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-family: 'Nunito', sans-serif;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--gray-600);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .content-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            position: relative;
            overflow: hidden;
        }

        .content-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid rgba(67, 97, 238, 0.1);
            font-family: 'Nunito', sans-serif;
        }

        .item-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .item-card {
            background: var(--gray-50);
            border-radius: 12px;
            padding: 1.25rem;
            border-left: 3px solid var(--primary);
            transition: all 0.3s ease;
        }

        .item-card:hover {
            background: rgba(67, 97, 238, 0.05);
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .item-title {
            font-weight: 700;
            color: var(--primary);
            font-size: 1rem;
        }

        .item-meta {
            font-size: 0.85rem;
            color: var(--gray-600);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .empty-state {
            text-align: center;
            padding: 2rem;
            color: var(--gray-600);
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 2rem;
        }

        .action-card {
            background: var(--gradient-primary);
            color: white;
            border-radius: 16px;
            padding: 1.5rem;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            position: relative;
            overflow: hidden;
        }

        .action-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            color: white;
        }

        .action-card:hover::before {
            opacity: 1;
        }

        .action-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .action-label {
            font-weight: 600;
            font-size: 1rem;
            position: relative;
            z-index: 1;
        }

        @media (max-width: 768px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-page">
        <div class="dashboard-container">
            <div class="page-header">
                <h1 class="page-title">
                    <i class="fas fa-tachometer-alt"></i> Dashboard Administrateur
                </h1>
                <p class="page-subtitle">Vue d'ensemble complète du système</p>
            </div>

            <!-- Statistiques -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <div>
                            <div class="stat-value">{{ totalBookings }}</div>
                            <div class="stat-label">Réservations</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div>
                            <div class="stat-value" style="color: #22c55e;">{{ totalPayments }}</div>
                            <div class="stat-label">Paiements</div>
                        </div>
                        <div class="stat-icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                            <i class="fas fa-credit-card"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div>
                            <div class="stat-value" style="color: #ff9e00;">{{ totalUsers }}</div>
                            <div class="stat-label">Utilisateurs</div>
                        </div>
                        <div class="stat-icon" style="background: rgba(255, 158, 0, 0.1); color: #ff9e00;">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div>
                            <div class="stat-value" style="color: #8b5cf6;">{{ totalRevenue|number_format(0, ',', ' ') }}€</div>
                            <div class="stat-label">Chiffre d'Affaires</div>
                        </div>
                        <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contenu récent -->
            <div class="content-grid">
                <!-- Réservations récentes -->
                <div class="content-card">
                    <h3 class="card-title">
                        <i class="fas fa-ticket-alt"></i> Réservations Récentes
                    </h3>
                    {% if recentBookings|length > 0 %}
                        <div class="item-list">
                            {% for booking in recentBookings %}
                                <div class="item-card">
                                    <div class="item-header">
                                        <div class="item-title">Réservation #{{ booking.id }}</div>
                                        <span style="color: var(--primary); font-weight: 600;">{{ booking.total|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                    <div class="item-meta">
                                        <i class="fas fa-ticket-alt"></i>
                                        {{ booking.quantity }} billet(s) • 
                                        <i class="far fa-calendar"></i>
                                        {{ booking.createdAt|date('d/m/Y H:i') }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-inbox" style="font-size: 3rem; color: var(--gray-200); margin-bottom: 1rem;"></i>
                            <p>Aucune réservation récente</p>
                        </div>
                    {% endif %}
                </div>

                <!-- Paiements récents -->
                <div class="content-card">
                    <h3 class="card-title">
                        <i class="fas fa-credit-card"></i> Paiements Récents
                    </h3>
                    {% if recentPayments|length > 0 %}
                        <div class="item-list">
                            {% for payment in recentPayments %}
                                <div class="item-card">
                                    <div class="item-header">
                                        <div class="item-title">Paiement #{{ payment.id }}</div>
                                        <span style="color: var(--primary); font-weight: 600;">{{ payment.amount|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                    <div class="item-meta">
                                        <i class="far fa-calendar"></i>
                                        {{ payment.createdAt|date('d/m/Y H:i') }} • 
                                        {% if payment.status == 'completed' %}
                                            <span style="color: #22c55e; font-weight: 600;"><i class="fas fa-check-circle"></i> Complété</span>
                                        {% else %}
                                            <span style="color: #ff9e00; font-weight: 600;"><i class="fas fa-clock"></i> En attente</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-credit-card" style="font-size: 3rem; color: var(--gray-200); margin-bottom: 1rem;"></i>
                            <p>Aucun paiement récent</p>
                        </div>
                    {% endif %}
                </div>

                <!-- Utilisateurs récents -->
                <div class="content-card">
                    <h3 class="card-title">
                        <i class="fas fa-users"></i> Utilisateurs Récents
                    </h3>
                    {% if recentUsers|length > 0 %}
                        <div class="item-list">
                            {% for user in recentUsers %}
                                <div class="item-card">
                                    <div class="item-header">
                                        <div class="item-title">{{ user.email }}</div>
                                        {% if user.getRole() == 'admin' %}
                                            <span style="color: var(--primary); font-size: 0.85rem; font-weight: 600;"><i class="fas fa-shield-alt"></i> Admin</span>
                                        {% else %}
                                            <span style="color: var(--gray-600); font-size: 0.85rem;"><i class="fas fa-user"></i> User</span>
                                        {% endif %}
                                    </div>
                                    <div class="item-meta">
                                        {% if user.isVerified() %}
                                            <span style="color: #22c55e; font-weight: 600;"><i class="fas fa-check-circle"></i> Vérifié</span>
                                        {% else %}
                                            <span style="color: #ff9e00; font-weight: 600;"><i class="fas fa-clock"></i> Non vérifié</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-users" style="font-size: 3rem; color: var(--gray-200); margin-bottom: 1rem;"></i>
                            <p>Aucun utilisateur récent</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Actions rapides -->
            <div class="quick-actions">
                <a href="{{ path('app_user_index') }}" class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="action-label">Gérer les Utilisateurs</div>
                </a>
                <a href="{{ path('app_booking_index') }}" class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <div class="action-label">Voir les Réservations</div>
                </a>
                <a href="{{ path('app_payment_index') }}" class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <div class="action-label">Voir les Paiements</div>
                </a>
                <a href="{{ path('app_user_new') }}" class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="action-label">Créer un Utilisateur</div>
                </a>
            </div>
        </div>
    </div>
{% endblock %}
