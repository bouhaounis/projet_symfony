{% extends 'base.html.twig' %}

{% block title %}🏟️ Gestion des Lieux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #ff9e00;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
        }

        .venues-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .venues-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 0;
        }

        .page-subtitle {
            color: var(--gray-600);
            margin-top: 0.5rem;
        }

        .venues-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .venue-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(67, 97, 238, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .venue-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .venue-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(67, 97, 238, 0.15);
        }

        .venue-card:hover::before {
            transform: scaleX(1);
        }

        .venue-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .venue-icon {
            width: 60px;
            height: 60px;
            background: rgba(67, 97, 238, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--primary);
        }

        .venue-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.75rem;
        }

        .venue-info {
            font-size: 0.9rem;
            color: var(--gray-600);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .venue-info-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .venue-capacity {
            background: rgba(67, 97, 238, 0.1);
            color: var(--primary);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 0.5rem 0.9rem;
            border-radius: 8px;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-view {
            background: rgba(67, 97, 238, 0.1);
            color: var(--primary);
            border: 1.5px solid var(--primary);
        }

        .btn-view:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .btn-edit {
            background: rgba(67, 97, 238, 0.1);
            color: var(--primary);
            border: 1.5px solid var(--primary);
        }

        .btn-edit:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .btn-delete {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1.5px solid #ef4444;
        }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        .btn-create {
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .btn-create:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .empty-icon {
            font-size: 5rem;
            color: rgba(67, 97, 238, 0.2);
            margin-bottom: 1.5rem;
        }

        .empty-title {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        @media (max-width: 768px) {
            .venues-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="venues-page">
        <div class="venues-container">
            <div class="page-header">
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-map-marker-alt"></i> Gestion des Lieux
                    </h1>
                    <p class="page-subtitle">Gérez les lieux où se déroulent vos événements (la capacité détermine le nombre de tickets disponibles)</p>
                </div>
                <a href="{{ path('app_venue_new') }}" class="btn-create">
                    <i class="fas fa-plus"></i> Nouveau Lieu
                </a>
            </div>

            {% if venues|length > 0 %}
                <div class="venues-grid">
                    {% for venue in venues %}
                        <div class="venue-card">
                            <div class="venue-header">
                                <div style="flex: 1;">
                                    <div class="venue-name">{{ venue.name }}</div>
                                    <div class="venue-info">
                                        <div class="venue-info-item">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <span>{{ venue.adresse }}</span>
                                        </div>
                                        <div class="venue-info-item">
                                            <i class="fas fa-calendar-alt"></i>
                                            <span>{{ venue.events|length }} événement(s)</span>
                                        </div>
                                    </div>
                                    <div class="venue-capacity">
                                        <i class="fas fa-users"></i>
                                        {{ venue.capacity }} places
                                    </div>
                                </div>
                                <div class="venue-icon">
                                    <i class="fas fa-building"></i>
                                </div>
                            </div>
                            <div class="action-buttons">
                                <a href="{{ path('app_venue_show', {'id': venue.id}) }}" class="btn-action btn-view">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_venue_edit', {'id': venue.id}) }}" class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                {{ include('venue/_delete_form.html.twig') }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h3 class="empty-title">Aucun lieu</h3>
                    <p style="color: var(--gray-600); margin-bottom: 1.5rem;">Créez votre premier lieu pour organiser vos événements</p>
                    <a href="{{ path('app_venue_new') }}" class="btn-create">
                        <i class="fas fa-plus"></i> Créer un lieu
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

