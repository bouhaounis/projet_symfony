<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}✨ Event Booking | Réservations d'Événements{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><text y='1.2em' font-size='96'>🎉</text></svg>">

    <!-- Google Fonts Joyeuses -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS Joyeux et Coloré avec Images -->
    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #4895ef;
            --secondary: #f72585;
            --accent: #4cc9f0;
            --success: #38b000;
            --warning: #ff9e00;
            --danger: #ef476f;
            --light: #f8f9fa;
            --white: #ffffff;
            --gray: #6c757d;
            --shadow: rgba(0, 0, 0, 0.1);
            --gradient-primary: linear-gradient(135deg, #4361ee, #4895ef);
            --gradient-secondary: linear-gradient(135deg, #f72585, #b5179e);
            --gradient-accent: linear-gradient(135deg, #4cc9f0, #3a86ff);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--white);
            color: #333;
            min-height: 100vh;
            line-height: 1.6;
            position: relative;
        }

        /* Arrière-plan avec images d'événements */
        .events-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            opacity: 0.15;
            background-image:
                url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80'),
                url('https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80'),
                url('https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80'),
                url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80');
            background-size: cover, cover, cover, cover;
            background-position:
                top 20% left 10%,
                top 60% right 15%,
                bottom 30% left 20%,
                bottom 10% right 25%;
            background-blend-mode: overlay;
            background-color: rgba(255, 255, 255, 0.95);
            filter: brightness(1.1) saturate(0.8);
        }

        /* Overlay coloré */
        .color-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background:
                radial-gradient(circle at 20% 30%, rgba(67, 97, 238, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(247, 37, 133, 0.06) 0%, transparent 50%),
                radial-gradient(circle at 40% 70%, rgba(76, 201, 240, 0.07) 0%, transparent 50%),
                radial-gradient(circle at 60% 80%, rgba(255, 158, 0, 0.05) 0%, transparent 50%);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navigation Joyeuse avec fond semi-transparent */
        .nav-joyful {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px var(--shadow);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 3px solid var(--primary);
        }

        .nav-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-brand {
            font-family: 'Nunito', sans-serif;
            font-size: 2rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-brand i {
            background: var(--gradient-primary);
            padding: 10px;
            border-radius: 12px;
            color: white;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .nav-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 25px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.9);
            border: 2px solid transparent;
        }

        .nav-link:hover {
            background: var(--gradient-primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
            border-color: var(--primary);
        }

        .nav-link.active {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            border-color: var(--primary);
        }

        /* Cartes Joyeuses avec fond semi-transparent */
        .joyful-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.8);
            position: relative;
            overflow: hidden;
        }

        .joyful-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: var(--gradient-primary);
        }

        .joyful-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(67, 97, 238, 0.2);
            border-color: var(--primary-light);
            background: rgba(255, 255, 255, 0.98);
        }

        /* Titres Joyeux */
        .joyful-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 1.5rem;
            position: relative;
            display: inline-block;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }

        .joyful-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 60px;
            height: 4px;
            background: var(--gradient-secondary);
            border-radius: 2px;
        }

        /* Header principal avec slider d'événements */
        .main-header {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.3)),
            url('https://images.unsplash.com/photo-1492684223066-e9e4a46c8a6b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 4rem 0;
            text-align: center;
            border-radius: 20px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .main-header h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }

        .main-header p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.9;
        }

        /* Section événements en vedette */
        .featured-events {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin: 2rem 0;
        }

        .event-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .event-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(67, 97, 238, 0.2);
            border-color: var(--primary);
        }

        .event-image {
            height: 180px;
            width: 100%;
            background-size: cover;
            background-position: center;
        }

        .event-content {
            padding: 1.5rem;
        }

        /* Boutons Colorés */
        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            border: none;
            padding: 0.75rem 1.75rem;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            color: white;
        }

        /* Messages Flash */
        .flash-messages {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 1000;
            max-width: 400px;
        }

        .alert-joyful {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            border-left: 5px solid var(--primary);
            color: #333;
            padding: 1.25rem;
            border-radius: 12px;
            margin-bottom: 1rem;
            animation: slideIn 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Contenu principal */
        .main-content {
            padding: 2rem 0;
            min-height: calc(100vh - 250px);
        }

        /* Footer */
        .footer-joyful {
            background: linear-gradient(135deg, rgba(42, 45, 62, 0.95), rgba(26, 29, 41, 0.95));
            color: white;
            padding: 3rem 0 2rem;
            margin-top: 4rem;
            backdrop-filter: blur(10px);
            border-top: 3px solid var(--primary);
        }

        /* Animation de particules */
        .floating {
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-content {
                flex-direction: column;
                gap: 1rem;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
            }

            .joyful-title {
                font-size: 2rem;
            }

            .main-header h1 {
                font-size: 2.5rem;
            }

            .flash-messages {
                left: 20px;
                right: 20px;
                max-width: none;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        <!-- Scripts JavaScript optionnels -->
    {% endblock %}
</head>
<body>
<!-- Arrière-plan avec images d'événements -->
<div class="events-background"></div>
<div class="color-overlay"></div>

<!-- Navigation -->
<nav class="nav-joyful">
    <div class="container">
        <div class="nav-content">
            <a href="{{ path('app_booking_index') }}" class="nav-brand floating">
                <i class="fas fa-calendar-alt"></i>
                EventBooking
            </a>
            <div class="nav-links">
                <a href="{{ path('app_booking_index') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_booking_index' %}active{% endif %}">
                    <i class="fas fa-ticket-alt"></i> Mes Réservations
                </a>
                <a href="{{ path('app_booking_new') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_booking_new' %}active{% endif %}">
                    <i class="fas fa-plus"></i> Nouvelle Réservation
                </a>
                <a href="#" class="nav-link">
                    <i class="fas fa-music"></i> Concerts
                </a>
                <a href="#" class="nav-link">
                    <i class="fas fa-theater-masks"></i> Spectacles
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- Messages Flash -->
<div class="flash-messages">
    {% for message in app.flashes('success') %}
        <div class="alert-joyful alert-success">
            <i class="fas fa-check-circle" style="color: var(--success); font-size: 1.2rem;"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert-joyful alert-error">
            <i class="fas fa-exclamation-circle" style="color: var(--danger); font-size: 1.2rem;"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert-joyful alert-warning">
            <i class="fas fa-exclamation-triangle" style="color: var(--warning); font-size: 1.2rem;"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
</div>

<!-- Contenu principal -->
<main class="main-content">
    <div class="container">
        <!-- Header principal -->
        <div class="main-header">
            <h1>🎉 Réservez vos événements préférés !</h1>
            <p>Concerts, spectacles, festivals, expositions... Vivez des expériences inoubliables !</p>
            <a href="{{ path('app_booking_new') }}" class="btn-primary" style="margin-top: 1.5rem;">
                <i class="fas fa-rocket"></i> Créer une réservation
            </a>
        </div>

        <!-- Section événements en vedette (optionnelle) -->
        <div class="featured-events">
            <div class="event-card">
                <div class="event-image" style="background-image: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');"></div>
                <div class="event-content">
                    <h4>🎵 Festival de Musique</h4>
                    <p>3 jours de musique live avec les meilleurs artistes</p>
                </div>
            </div>
            <div class="event-card">
                <div class="event-image" style="background-image: url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');"></div>
                <div class="event-content">
                    <h4>🎭 Comédie Musicale</h4>
                    <p>Un spectacle époustouflant à ne pas manquer</p>
                </div>
            </div>
            <div class="event-card">
                <div class="event-image" style="background-image: url('https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');"></div>
                <div class="event-content">
                    <h4>🎨 Exposition d'Art</h4>
                    <p>Découvrez les œuvres d'artistes contemporains</p>
                </div>
            </div>
        </div>

        <!-- Contenu des pages (sera rempli par les templates enfants) -->
        {% block body %}{% endblock %}
    </div>
</main>

<!-- Footer -->
<footer class="footer-joyful">
    <div class="container">
        <div style="text-align: center;">
            <h3 style="margin-bottom: 1rem; color: var(--accent);">
                <i class="fas fa-calendar-star"></i> EventBooking
            </h3>
            <p style="max-width: 600px; margin: 0 auto 1.5rem; opacity: 0.9;">
                Votre billetterie en ligne pour les meilleurs événements culturels, musicaux et festifs !
            </p>
            <div style="display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 2rem;">
                <span>🎵 Concerts</span>
                <span>🎭 Théâtre</span>
                <span>🎨 Expositions</span>
                <span>🎪 Festivals</span>
            </div>
            <p style="opacity: 0.7; font-size: 0.9rem;">
                &copy; {{ "now"|date("Y") }} EventBooking - Tous droits réservés |
                <i class="fas fa-heart" style="color: var(--secondary);"></i> Réalisé avec passion
            </p>
        </div>
    </div>
</footer>
</body>
</html>
