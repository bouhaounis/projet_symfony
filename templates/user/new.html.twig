{% extends 'base.html.twig' %}

{% block title %}➕ Nouvel Utilisateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-header,
        .featured-events {
            display: none !important;
        }

        :root {
            --primary: #4361ee;
            --gray-50: #f9fafb;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
        }

        .user-form-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(67, 97, 238, 0.1);
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .form-title {
            font-family: 'Nunito', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 2rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 1rem 1.25rem;
            font-size: 1rem;
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            transition: all 0.3s ease;
            background: var(--gray-50);
            color: var(--gray-800);
            font-family: 'Poppins', sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            padding: 1rem;
            background: var(--gray-50);
            border-radius: 12px;
            border: 2px solid var(--gray-200);
        }

        .form-check-input {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .form-check-label {
            font-size: 0.9rem;
            color: var(--gray-700);
            cursor: pointer;
        }

        .btn-submit {
            width: 100%;
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1.1rem 2rem;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            margin-top: 1rem;
            font-family: 'Poppins', sans-serif;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
        }

        .btn-back {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            margin-top: 1rem;
            width: 100%;
            justify-content: center;
        }

        .btn-back:hover {
            background: var(--primary);
            color: white;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 2rem;
            }

            .form-title {
                font-size: 2rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="user-form-page">
        <div class="form-container">
            <div class="form-card">
                <h1 class="form-title">
                    <i class="fas fa-user-plus"></i> Nouvel Utilisateur
                </h1>

                {{ form_start(form) }}
                    {{ form_row(form.email, {
                        'label': 'Email',
                        'attr': {'class': 'form-control', 'placeholder': 'utilisateur@example.com'}
                    }) }}

                    <div class="form-row">
                        {{ form_row(form.plainPassword.first, {
                            'label': 'Mot de passe',
                            'attr': {'class': 'form-control', 'placeholder': '••••••••'}
                        }) }}

                        {{ form_row(form.plainPassword.second, {
                            'label': 'Confirmer le mot de passe',
                            'attr': {'class': 'form-control', 'placeholder': '••••••••'}
                        }) }}
                    </div>

                    {{ form_row(form.role, {
                        'label': 'Rôle',
                        'attr': {'class': 'form-control'}
                    }) }}

                    <div class="form-check">
                        {{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.isVerified, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-check"></i> Créer l'utilisateur
                    </button>
                {{ form_end(form) }}

                <a href="{{ path('app_user_index') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}
