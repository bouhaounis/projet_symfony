<form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette catégorie ? Les événements associés ne seront pas supprimés mais perdront leur catégorie.');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button type="submit" class="btn-action btn-delete">
        <i class="fas fa-trash"></i> Supprimer
    </button>
</form>

